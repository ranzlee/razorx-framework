<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    
    <!-- NuGet Package Properties -->
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageId>RazorX.Framework</PackageId>
    <PackageVersion>1.0.0</PackageVersion>
    <Authors>Randy Lee</Authors>
    <Description>Server-Driven User Interface (SDUI) hypermedia framework implementing true HATEOAS principles with C#/.NET 9 and TypeScript client library.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>SDUI;hypermedia;HATEOAS;ASP.NET Core;TypeScript;HTML-over-the-wire</PackageTags>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="RazorX.Framework.Tests" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!-- Include TypeScript client distribution files in NuGet package -->
  <ItemGroup>
    <None Include="Node/dist/razorx.js" Pack="true" PackagePath="contentFiles/any/any/wwwroot/js/razorx.js" />
    <None Include="Node/dist/razorx.js.map" Pack="true" PackagePath="contentFiles/any/any/wwwroot/js/razorx.js.map" />
    <None Include="Node/dist/razorx.d.ts" Pack="true" PackagePath="contentFiles/any/any/wwwroot/js/razorx.d.ts" />
    <None Include="build/RazorX.Framework.targets" Pack="true" PackagePath="build/RazorX.Framework.targets" />
    <None Include="buildTransitive/RazorX.Framework.targets" Pack="true" PackagePath="buildTransitive/RazorX.Framework.targets" />
    <None Include="../README.md" Pack="true" PackagePath="README.md" />
  </ItemGroup>

  <Target Name="NodeInstall" BeforeTargets="Compile" Condition="!Exists('Node/node_modules')">
    <!-- Ensure Node.js is installed -->
    <Exec Command="node --version" ContinueOnError="true">
      <Output TaskParameter="ExitCode" PropertyName="ErrorCode" />
    </Exec>
    <Error Condition="'$(ErrorCode)' != '0'" Text="Node.js is required to build this project. To continue, please install Node.js from https://nodejs.org/, and then restart your command prompt or IDE." />
    <!-- Install npm packages -->
    <Message Importance="High" Text="Restoring dependencies using 'npm'. This may take several minutes..." />
    <Exec WorkingDirectory="Node" Command="npm install" />
  </Target>

  <Target Name="JS build" BeforeTargets="Compile">
    <Message Importance="High" Text="Building the razorx.js script" />
    <Exec WorkingDirectory="Node" Command="npm run build" />
  </Target>

</Project>
