<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    
    <!-- NuGet Package Properties -->
    <GeneratePackageOnBuild Condition="'$(Configuration)' == 'Release' AND '$(CI)' != 'true'">true</GeneratePackageOnBuild>
    <PackageId>RazorX.Framework</PackageId>
    <PackageVersion>1.0.0-alpha</PackageVersion>
    <Authors>Randy Lee</Authors>
    <Company>RazorX Framework</Company>
    <Product>RazorX Framework</Product>
    <Title>RazorX Framework - Server-Driven UI Framework</Title>
    <Description>A production-ready Server-Driven User Interface (SDUI) hypermedia framework implementing true HATEOAS principles. Combines C#/.NET 9 server-side rendering with an intelligent TypeScript client library to deliver HTML-over-the-wire functionality with exceptional developer experience.</Description>
    <Summary>Server-Driven UI framework with C#/.NET 9 backend and TypeScript client for hypermedia applications</Summary>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>SDUI;hypermedia;HATEOAS;ASP.NET Core;TypeScript;HTML-over-the-wire;server-driven;web-framework</PackageTags>
    <PackageReleaseNotes>See CHANGELOG.md for detailed release notes</PackageReleaseNotes>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/ranzlee/razorx-framework</RepositoryUrl>
    <RepositoryBranch>main</RepositoryBranch>
    <PackageProjectUrl>https://github.com/ranzlee/razorx-framework</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <DeterministicSourcePaths>true</DeterministicSourcePaths>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    
    <!-- Framework requirements -->
    <MinClientVersion>4.0</MinClientVersion>
    <DevelopmentDependency>false</DevelopmentDependency>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="RazorX.Framework.Tests" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="All" />
  </ItemGroup>

  <!-- Include TypeScript client distribution files in NuGet package -->
  <ItemGroup>
    <None Include="Node/dist/razorx.js" Pack="true" PackagePath="contentFiles/any/any/wwwroot/js/razorx.js" />
    <None Include="Node/dist/razorx.js.map" Pack="true" PackagePath="contentFiles/any/any/wwwroot/js/razorx.js.map" />
    <None Include="Node/dist/razorx.d.ts" Pack="true" PackagePath="contentFiles/any/any/wwwroot/js/razorx.d.ts" />
    <None Include="build/RazorX.Framework.targets" Pack="true" PackagePath="build/RazorX.Framework.targets" />
    <None Include="buildTransitive/RazorX.Framework.targets" Pack="true" PackagePath="buildTransitive/RazorX.Framework.targets" />
    <None Include="../README.md" Pack="true" PackagePath="README.md" />
  </ItemGroup>

  <Target Name="NodeInstall" BeforeTargets="Compile" Condition="!Exists('Node/node_modules')">
    <!-- Ensure Node.js is installed -->
    <Exec Command="node --version" ContinueOnError="true">
      <Output TaskParameter="ExitCode" PropertyName="ErrorCode" />
    </Exec>
    <Error Condition="'$(ErrorCode)' != '0'" Text="Node.js is required to build this project. To continue, please install Node.js from https://nodejs.org/, and then restart your command prompt or IDE." />
    <!-- Install npm packages -->
    <Message Importance="High" Text="Restoring dependencies using 'npm'. This may take several minutes..." />
    <Exec WorkingDirectory="Node" Command="npm install" />
  </Target>

  <Target Name="JS build" BeforeTargets="Compile">
    <Message Importance="High" Text="Building the razorx.js script" />
    <Exec WorkingDirectory="Node" Command="npm run build" />
  </Target>

</Project>
