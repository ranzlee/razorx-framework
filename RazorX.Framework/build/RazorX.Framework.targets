<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <!-- Copy RazorX client files to consuming project's wwwroot/js folder -->
  <Target Name="CopyRazorXClientFiles" BeforeTargets="Build">
    
    <!-- Ensure wwwroot/js directory exists -->
    <MakeDir Directories="$(MSBuildProjectDirectory)/wwwroot/js" Condition="!Exists('$(MSBuildProjectDirectory)/wwwroot/js')" />
    
    <!-- Copy JavaScript file -->
    <Copy 
      SourceFiles="$(MSBuildThisFileDirectory)../contentFiles/any/any/wwwroot/js/razorx.js"
      DestinationFiles="$(MSBuildProjectDirectory)/wwwroot/js/razorx.js"
      SkipUnchangedFiles="true"
      Condition="Exists('$(MSBuildThisFileDirectory)../contentFiles/any/any/wwwroot/js/razorx.js')" />
    
    <!-- Copy source map -->
    <Copy 
      SourceFiles="$(MSBuildThisFileDirectory)../contentFiles/any/any/wwwroot/js/razorx.js.map"
      DestinationFiles="$(MSBuildProjectDirectory)/wwwroot/js/razorx.js.map"
      SkipUnchangedFiles="true"
      Condition="Exists('$(MSBuildThisFileDirectory)../contentFiles/any/any/wwwroot/js/razorx.js.map')" />
    
    <!-- Copy TypeScript definitions -->
    <Copy 
      SourceFiles="$(MSBuildThisFileDirectory)../contentFiles/any/any/wwwroot/js/razorx.d.ts"
      DestinationFiles="$(MSBuildProjectDirectory)/wwwroot/js/razorx.d.ts"
      SkipUnchangedFiles="true"
      Condition="Exists('$(MSBuildThisFileDirectory)../contentFiles/any/any/wwwroot/js/razorx.d.ts')" />
    
    <Message Importance="high" Text="RazorX.Framework: Copied client files to wwwroot/js/" />
    
  </Target>

</Project>