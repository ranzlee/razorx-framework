<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- AOT Compatibility -->
    <IsAotCompatible>true</IsAotCompatible>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>

    <!-- XML Documentation -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!-- NuGet Package Properties -->
    <PackageId>RazorX.Framework.Redis</PackageId>
    <PackageVersion>1.0.0-alpha</PackageVersion>
    <Authors>Randy Lee</Authors>
    <Company>RazorX Framework</Company>
    <Product>RazorX Framework Redis Transport</Product>
    <Title>RazorX.Framework.Redis - Redis Pub/Sub Transport</Title>
    <Description>Redis Pub/Sub transport for distributed RazorX.Framework SSE broadcasts across multiple servers. AOT-compatible.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>RazorX;Redis;Pub/Sub;distributed;SSE;server-sent-events;AOT</PackageTags>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/ranzlee/razorx-framework</RepositoryUrl>
    <PackageProjectUrl>https://github.com/ranzlee/razorx-framework</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="StackExchange.Redis" Version="2.8.16" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../RazorX.Framework/RazorX.Framework.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="README.md" />
  </ItemGroup>
</Project>
