<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\RazorX.Framework\RazorX.Framework.csproj" />
  </ItemGroup>

  <Target Name="CopyJsFiles" AfterTargets="Compile">
    <ItemGroup>
      <JsFiles Include="../RazorX.Framework/Node/dist/js/*.*"/>
    </ItemGroup>
    <Copy SourceFiles="@(JsFiles)" DestinationFolder="wwwroot/js" />
  </Target>

  <Target Name="CopyCssFiles" AfterTargets="Compile">
    <ItemGroup>
      <CssFiles Include="../RazorX.Framework/Node/dist/css/*.*"/>
    </ItemGroup>
    <Copy SourceFiles="@(CssFiles)" DestinationFolder="wwwroot/css" />
  </Target>

</Project>
