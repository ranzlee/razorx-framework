@implements IComponentModel<string?>

<div class="correlation-info">
    <span style="font-size: 0.8rem; color: #666;">
        Correlation ID: <code style="background: #f4f4f4; padding: 2px 6px; border-radius: 3px;">@(Model ?? "N/A")</code>
    </span>
</div>

@code {
    [Parameter] public string? Model { get; set; }
}