@implements IComponentModel<TodoModel>

<article id="todo-item-@(Model.Id)"
    data-rx-action="@(SetRevealedTrigger ? $"/todo/next/{Model.Id}" : false)"
    data-rx-trigger="@(SetRevealedTrigger ? "rx:revealed" : false)">
    <button
        id="edit-todo-modal-trigger-@(Model.Id)"
        data-rx-action="/todo/@(Model.Id)"
        data-rx-method="GET"
        class="outline">
        Edit
    </button>
    <button id="delete-todo-modal-trigger-@(Model.Id)"
        data-rx-action="/todo/@(Model.Id)"
        data-rx-method="DELETE"
        data-rx-hoist-to="delete-todo-modal-ok"
        class="outline secondary">
        Delete
    </button>
    @(Model.Text)
    <script>
        (function(){
            const todoModal = document.getElementById("edit-todo-modal");
            const confirmModal = document.getElementById("delete-todo-modal");
            const dismiss = document.getElementById("delete-todo-modal-close");
            const deleteTrigger = document.getElementById("delete-todo-modal-trigger-@(Model.Id)");
            const editTrigger = document.getElementById("edit-todo-modal-trigger-@(Model.Id)");
            deleteTrigger.onclick = () => {
                confirmModal.showModal();
            }
            editTrigger.onclick = () => {
                todoModal.showModal();
            }
            dismiss.onclick = () => {
                confirmModal.close();
            }
        })()
    </script>
</article>

@code {
    [Parameter] public TodoModel Model { get; set; } = null!;
    [Parameter] public bool SetRevealedTrigger { get; set; }
}