@implements IComponentModel<IEnumerable<TodoModel>>

<dialog id="new-todo-modal">
  <article>
    <h2>New</h2>
    <TodoForm Model="@(new TodoFormModel(0, "", false, false, false))"></TodoForm>
    <footer>
      <button id="new-todo-modal-close" type="button" class="secondary" data-rx-method="GET" data-rx-action="/new-todo-reset">Cancel</button>
      <button id="new-todo-save" form="new-todo-form">Save</button>
    </footer>
  </article>
</dialog>

<dialog id="edit-todo-modal">
  <article>
    <h2>Edit</h2>
    <div id="edit-todo-form-container"></div>
    <footer>
      <button id="edit-todo-modal-close" type="button" class="secondary" data-rx-method="GET" data-rx-action="/edit-todo-reset">Cancel</button>
      <button id="edit-todo-save" form="edit-todo-form">Save</button>
    </footer>
  </article>
</dialog>

<dialog id="delete-todo-modal">
  <article>
    <h2>Delete</h2>
    <p>Are you sure?</p>
    <footer>
      <button id="delete-todo-modal-close" type="button" class="secondary">Cancel</button>
      <button id="delete-todo-modal-ok">OK</button>
    </footer>
  </article>
</dialog>

<div class="grid">
  <div>
    <input id="search-todos" 
      type="search" 
      name="filter"
      data-rx-method="get"
      data-rx-action="/search-todos" 
      data-rx-debounce="400"
      data-rx-trigger="input"
      placeholder="Search" 
      aria-label="Search"
      autocomplete="off">
  </div>
  <div class="flex justify-right">
    <button id="new-todo-modal-trigger">New</button>
  </div>
</div>
<div>
  <TodoCount Model="(Model.Count(x => x.IsComplete), Model.Count())"/>
</div>
<br>
<TodoList Model="@(Model)"></TodoList>


<script>
  (function(){
    const newModal = document.getElementById("new-todo-modal");
    const newDismiss = document.getElementById("new-todo-modal-close");
    const newTrigger = document.getElementById("new-todo-modal-trigger");
    newTrigger.onclick = () => {
      newModal.showModal();
    }
    newDismiss.onclick = () => {
      newModal.close(); 
    }
  })()
</script>

@code {
    [Parameter] public IEnumerable<TodoModel> Model { get; set; } = [];
}
