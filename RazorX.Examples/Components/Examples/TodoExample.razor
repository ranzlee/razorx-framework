@implements IComponentModel<ExampleModel>

<dialog id="new-todo-modal">
  <article>
    <h2>New</h2>
    <TodoForm Model="@(new TodoFormModel(0, "", false, false, false))"></TodoForm>
    <footer>
      <button id="new-todo-modal-close" type="button" class="secondary" data-rx-method="GET" data-rx-action="/new-todo-reset">Cancel</button>
      <button id="new-todo-save" form="new-todo-form">Save</button>
    </footer>
  </article>
</dialog>

<dialog id="edit-todo-modal">
  <article>
    <h2>Edit</h2>
    <div id="edit-todo-form-container">
      <TodoFormLoading />
    </div>
    <footer>
      <button id="edit-todo-modal-close" type="button" form="edit-todo-form" class="secondary" data-rx-method="GET" data-rx-action="/edit-todo-reset">Cancel</button>
      <button id="edit-todo-save" form="edit-todo-form">
        Save
        <span id="edit-loading" aria-busy="true" class="rx-loading-hidden"></span>
      </button>
    </footer>
  </article>
</dialog>

<dialog id="delete-todo-modal">
  <article>
    <h2>Delete</h2>
    <p>Are you sure?</p>
    <footer>
      <button id="delete-todo-modal-close" type="button" class="secondary">Cancel</button>
      <button id="delete-todo-modal-ok" data-rx-include-state="filter">OK</button>
    </footer>
  </article>
</dialog>

@* <div
  id="poll-test"
  data-rx-action="/poll-test" 
  data-rx-trigger="@(value: "{ \"type\": \"poll\", \"interval\": 4000 }")" >
</div> *@

<div
  id="content"
  data-rx-method="get"
  data-rx-action="/search-todos" 
  data-rx-trigger="@(value: "{ \"type\": \"initialized\", \"delay\": 100 }")"
  data-rx-include-state="filter"
  class="grid">
  <div>
    <TodoSearch Model="" />
  </div>
  <div class="flex justify-right">
    <button id="new-todo-modal-trigger">New</button>
  </div>
</div>
<div>
  <TodoCount Model="(Model.Completed, Model.Total)"/>
</div>
<br>
<div id="todo-list" style="height: 500px; overflow-x: auto;">
    <TodoList Model="@(Model.Todos)" />
</div>


<script>
  (function(){
    const newModal = document.getElementById("new-todo-modal");
    const newDismiss = document.getElementById("new-todo-modal-close");
    const newTrigger = document.getElementById("new-todo-modal-trigger");
    newTrigger.onclick = () => {
      newModal.showModal();
    }
    newDismiss.onclick = () => {
      newModal.close(); 
    }
  })()
</script>

@code {
    [Parameter] public ExampleModel Model { get; set; } = null!;
}
