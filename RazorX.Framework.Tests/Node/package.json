{
  "name": "razorx-tests",
  "version": "1.0.0",
  "description": "Node test runner for the RazorX.Framework JavaScript client.",
  "main": "razorx.js",
  "scripts": {
    "prebuild": "tsc",
    "build": "node esbuild.mjs",
    "test": "vitest run --reporter=verbose",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:coverage:watch": "vitest --coverage",
    "test:coverage:report": "vitest run --coverage --reporter=verbose",
    "test:coverage:check": "vitest run --coverage --reporter=basic",
    "test:ci": "vitest run --reporter=verbose",
    "test:silent": "vitest run --reporter=basic"
  },
  "keywords": [
    "RazorX",
    "RazorX.Framework",
    "RazorX.Framework.Tests"
  ],
  "author": "Randy Lee",
  "license": "MIT",
  "type": "module",
  "devDependencies": {
    "@eslint/js": "^9.37.0",
    "@types/node": "^24.8.1",
    "@vitest/coverage-v8": "^4.0.6",
    "esbuild": "^0.25.10",
    "eslint": "^9.37.0",
    "globals": "^16.4.0",
    "jsdom": "^27.1.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.1",
    "vitest": "^4.0.6"
  },
  "dependencies": {
    "idiomorph": "^0.7.4"
  }
}
